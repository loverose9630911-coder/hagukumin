  {
    "id": "01-1",
    "prefCode": "01",
    "pref": "北海道",
    "name": "北海道神宮",
    "kana": "ほっかいどうじんぐう",
    "officialUrl": "http://www.hokkaidojingu.or.jp/",
    "sourceType": "official",
    "address": "北海道札幌市中央区宮ヶ丘474",
    "deities": [
      "大国魂神",
      "大那牟遅神",
      "少彦名神",
      "明治天皇"
    ],
    "benefitsOfficial": [],
    "history": "明治2年9月1日、東京の神祇官で開拓三神（大国魂神・大那牟遅神・少彦名神）を祀る「北海道鎮座神祭」が行われたのが創祀とされる。御霊代は札幌へ運ばれ、明治4年5月に社名が「札幌神社」と定められ、同年9月に現在の円山の地に社殿が完成した。昭和39年に明治天皇を増祀し、社名を「北海道神宮」と改めた。",
    "access": [
      "地下鉄東西線「円山公園駅」下車、徒歩15分",
      "JRバス「北海道神宮」停留所下車、徒歩1分",
      "JR札幌駅からタクシーで約15分"
    ],
    "hours": null,
    "festivals": [
      {
        "name": "宵宮祭",
        "date": "6月14日"
      },
      {
        "name": "例祭（札幌まつり）",
        "date": "6月15日"
      },
      {
        "name": "神輿渡御",
        "date": "6月16日"
      }
    ],
    "officialNotes": [
      "参拝には地下鉄・バス・タクシーなど公共交通機関の利用を呼びかけている（混雑時は駐車場が狭く渋滞しやすいとの案内）",
      "鳥居は神域の入り口を示すもので、くぐる場所によってご利益が変わることはないと説明している"
    ],
    "sources": [
