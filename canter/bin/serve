#!/usr/bin/env bash
# canter を立ち上げる。
#
#   bin/serve            → http://localhost:8090
#   PORT=3000 bin/serve  → ポートを変える
set -euo pipefail
cd "$(dirname "$0")/.."

PORT="${PORT:-8090}"
export PHP_CLI_SERVER_WORKERS="${PHP_CLI_SERVER_WORKERS:-4}"

mkdir -p data

if [ ! -f data/canter.sqlite ]; then
  echo "▶ 初回の起動なので、デモデータを入れます"
  bin/seed || true
fi

lan="$(hostname -I 2>/dev/null | awk '{print $1}')"
[ -z "$lan" ] && lan="$(ipconfig getifaddr en0 2>/dev/null || true)"

echo
echo "▶ canter を起動します"
echo "   このパソコン  →  http://localhost:${PORT}"
[ -n "$lan" ] && echo "   スマホなど    →  http://${lan}:${PORT}   （同じ Wi-Fi につないでください）"
echo
echo "   デモ用ログイン:  demo / demo1234"
echo
echo "   ※ Instagram・Threads・Notion に画像を出すには、インターネットから見える場所に置き、"
echo "      CANTER_PUBLIC_URL にそのアドレスを入れてください（README の「外に出す」を参照）。"
echo

exec php -S "0.0.0.0:${PORT}" -t public public/index.php
